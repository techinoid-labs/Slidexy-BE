        "x": 64,
        "y": 320,
        "width": 560,
        "height": 280,
        "morphId": "title"
      },
      {
        "z": 3,
        "id": "caption",
        "type": "text",
        "slot": "caption",
        "tokenColor": "muted",
        "fontRole": "body",
        "fontSize": 18,
        "align": "left",
        "x": 64,
        "y": 640,
        "width": 560,
        "height": 120,
