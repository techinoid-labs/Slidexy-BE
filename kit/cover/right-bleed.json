        "width": 1600,
        "height": 900,
        "morphId": "field"
      },
      {
        "z": 1,
        "id": "photo",
        "type": "image",
        "slot": "photo",
        "x": 680,
        "y": -48,
        "width": 1000,
        "height": 996,
        "morphId": "hero"
      },
      {
        "z": 2,
        "id": "accent-bar",
