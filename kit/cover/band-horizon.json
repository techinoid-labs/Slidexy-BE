        "y": 240,
        "width": 900,
        "height": 60,
        "morphId": "caption"
      },
      {
        "z": 4,
        "id": "title",
        "type": "text",
        "slot": "title",
        "tokenColor": "bg",
        "fontRole": "display",
        "fontSize": 80,
        "align": "left",
        "verticalAlign": "middle",
        "x": 72,
        "y": 340,
        "width": 1456,
        "height": 220,
        "morphId": "title"
      }
