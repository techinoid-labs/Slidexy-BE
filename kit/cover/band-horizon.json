        "height": 900,
        "morphId": "hero"
      },
      {
        "z": 2,
        "id": "band",
        "type": "shape",
        "shape": "rect",
        "tokenFill": "accent",
        "x": 0,
        "y": 320,
        "width": 1600,
        "height": 260,
        "morphId": "band"
      },
      {
        "z": 3,
        "id": "caption",
        "type": "text",
        "slot": "caption",
        "tokenColor": "bg",
