        "y": 120,
        "width": 1472,
        "height": 560,
        "morphId": "title"
      },
      {
        "z": 2,
        "id": "caption",
        "type": "text",
        "slot": "caption",
        "tokenColor": "muted",
        "fontRole": "body",
        "fontSize": 18,
        "align": "right",
        "x": 800,
        "y": 760,
        "width": 736,
        "height": 80,
        "morphId": "caption"
      }
