{
  "id": "cover/editorial-overlap",
  "role": "cover",
  "variant": "editorial-overlap",
  "family": "anti-grid",
  "steal": "Full-bleed photo; massive title half-off the left edge overlapping the image; small copy bottom-right.",
  "requiresPhoto": true,
  "photoSlots": ["photo"],
  "slots": {
    "title": { "kind": "text", "optional": false, "from": "title" },
    "caption": { "kind": "text", "optional": true, "from": "caption" },
    "photo": { "kind": "image", "optional": false, "from": "photo" }
  },
  "fit": {
    "title": { "maxFont": 100, "minFont": 72, "lineClamp": 2, "shrinkMin": 0.85 },
    "caption": { "maxFont": 22, "minFont": 16, "lineClamp": 3, "shrinkMin": 0.9 }
  },
  "pptxMapping": {
    "title": { "kind": "text" },
    "caption": { "kind": "text" },
    "photo": { "kind": "picture" }
  },
  "layout": {
    "elements": [
      {
        "z": 1,
        "id": "photo",
        "type": "image",
        "slot": "photo",
        "x": 0,
        "y": 0,
        "width": 1600,
        "height": 900,
        "morphId": "hero"
      },
      {
        "z": 2,
        "id": "wash",
        "type": "shape",
        "shape": "rect",
        "tokenFill": "ink",
        "opacity": 0.28,
        "x": 0,
        "y": 0,
        "width": 720,
        "height": 900,
        "morphId": "wash"
      },
      {
        "z": 4,
        "id": "title",
        "type": "text",
        "slot": "title",
        "tokenColor": "bg",
        "fontRole": "display",
        "fontSize": 100,
        "align": "left",
        "verticalAlign": "middle",
        "x": -80,
        "y": 280,
        "width": 980,
        "height": 280,
        "morphId": "title"
      },
      {
        "z": 4,
        "id": "caption",
        "type": "text",
        "slot": "caption",
        "tokenColor": "bg",
        "fontRole": "body",
        "fontSize": 20,
        "align": "right",
        "x": 980,
        "y": 720,
        "width": 540,
        "height": 120,
        "morphId": "caption"
      }
    ]
  },
  "status": "draft",
  "motion": { "transition": "fade", "fallbackTransition": "fade", "durationMs": 500 }
}
