  },
  "fit": {
    "title": { "maxFont": 40, "minFont": 28, "lineClamp": 1, "shrinkMin": 0.9 },
    "name": { "maxFont": 48, "minFont": 32, "lineClamp": 2, "shrinkMin": 0.9 },
    "roleLabel": { "maxFont": 24, "minFont": 18, "lineClamp": 1, "shrinkMin": 1 },
    "body": { "maxFont": 20, "minFont": 16, "lineClamp": 6, "shrinkMin": 0.9 }
  },
  "pptxMapping": {
    "title": { "kind": "text" },
    "name": { "kind": "text" },
    "roleLabel": { "kind": "text" },
    "body": { "kind": "text" },
    "portrait": { "kind": "picture" }
  },
