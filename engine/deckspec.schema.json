{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slidexy.local/engine/deckspec.schema.json",
  "title": "DeckSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style",
    "slides"
  ],
  "properties": {
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "typePair",
        "imageTreatment",
        "motif"
      ],
      "properties": {
        "palette": {
          "type": "string"
        },
        "typePair": {
          "type": "string"
        },
        "imageTreatment": {
          "type": "string"
        },
        "motif": {
          "type": "string"
        },
        "typeTreatment": {
          "type": "string"
        },
        "sequence": {
          "type": "string"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "title"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "cover",
              "agenda",
              "problem",
              "solution",
              "how-it-works",
              "feature",
              "stats",
              "testimonial",
              "team",
              "closing",
              "report",
              "timeline",
              "comparison",
              "pricing",
              "portfolio"
            ]
          },
          "variantHint": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "body": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 90
            }
          },
          "stats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 8
                },
                "label": {
                  "type": "string",
                  "maxLength": 30
                }
              }
            }
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "role"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 30
                },
                "role": {
                  "type": "string",
                  "maxLength": 30
                }
              }
            }
          },
          "caption": {
            "type": "string",
            "maxLength": 80
          },
          "photoQuery": {
            "type": "string",
            "maxLength": 120
          },
          "photoQueries": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "photoOrientation": {
            "type": "string",
            "enum": [
              "landscape",
              "portrait",
              "square"
            ]
          },
          "photoOrientations": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "landscape",
                "portrait",
                "square"
              ]
            }
          },
          "items": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 90
            }
          },
          "steps": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "string"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "popular": {
                  "type": "boolean"
                },
                "badge": {
                  "type": "string"
                }
              }
            }
          },
          "chart": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "labels",
              "series"
            ],
            "properties": {
              "type": {
                "enum": [
                  "donut",
                  "line",
                  "stackedBar"
                ]
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "values"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "holeSize": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "showPercent": {
                "type": "boolean"
              },
              "showLegend": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
