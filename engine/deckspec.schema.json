{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slidexy.local/engine/deckspec.schema.json",
  "title": "DeckSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["style", "slides"],
  "properties": {
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "typePair", "imageTreatment", "motif"],
      "properties": {
        "palette": { "type": "string" },
        "typePair": { "type": "string" },
        "imageTreatment": { "type": "string" },
        "motif": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "title"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "cover",
              "agenda",
              "problem",
              "solution",
              "how-it-works",
              "feature",
              "stats",
              "testimonial",
              "team",
              "closing"
            ]
          },
          "variantHint": { "type": "string", "enum": ["a", "b"] },
          "title": { "type": "string", "maxLength": 60 },
          "body": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "maxLength": 90 }
          },
          "stats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string", "maxLength": 8 },
                "label": { "type": "string", "maxLength": 30 }
              }
            }
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "role"],
              "properties": {
                "name": { "type": "string", "maxLength": 30 },
                "role": { "type": "string", "maxLength": 30 }
              }
            }
          },
          "caption": { "type": "string", "maxLength": 80 },
          "photoQuery": { "type": "string", "maxLength": 120 },
          "photoOrientation": {
            "type": "string",
            "enum": ["landscape", "portrait", "square"]
          }
        }
      }
    }
  }
}
