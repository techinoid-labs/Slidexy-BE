{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slidexy.local/engine/deckspec.schema.json",
  "title": "DeckSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["style", "slides"],
  "properties": {
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "typePair", "imageTreatment", "motif"],
      "properties": {
        "palette": { "type": "string" },
        "typePair": { "type": "string" },
        "imageTreatment": { "type": "string" },
        "motif": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "title"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "cover",
              "agenda",
              "problem",
              "solution",
              "how-it-works",
              "feature",
              "stats",
              "testimonial",
              "team",
              "closing"
            ]
          },
          "variantHint": { "type": "string", "enum": ["a", "b"] },
          "title": { "type": "string", "maxLength": 60 },
          "body": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "maxLength": 90 }
          },
          "stat": { "type": "string", "maxLength": 12 },
          "caption": { "type": "string", "maxLength": 80 },
          "photoQuery": { "type": "string", "maxLength": 120 },
          "photoOrientation": {
            "type": "string",
            "enum": ["landscape", "portrait", "square"]
          }
        }
      }
    }
  }
}
