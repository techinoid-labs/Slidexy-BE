{
  "version": 1,
  "label": "Slidexy Global Design System",
  "typography": {
    "bodyMinPt": 14,
    "titleMinPt": 24,
    "kickerPt": 10,
    "calloutPt": 20,
    "listItemPt": 16,
    "axisLabelMinPt": 12,
    "enforcement": "error-or-split",
    "bodyLineHeight": 1.5,
    "titleLineHeight": 1.2
  },
  "surfaces": {
    "light": {
      "surface_color": "#F8FAFC",
      "card_bg": "#FFFFFF"
    },
    "dark": {
      "surface_color": "#0F172A",
      "card_bg": "#1E293B"
    }
  },
  "card_shadow": {
    "color": "#0F172A",
    "blur": 24,
    "offset": 8,
    "opacity": 0.12
  },
  "shapes": {
    "cardRadius": 4,
    "useCards": true
  },
  "motif": {
    "id": "refined",
    "label": "Refined hairline + square",
    "hairlineHeight": 1,
    "hairlineWidth": 72,
    "squareSize": 4,
    "gap": 8,
    "forbidBrush": true,
    "forbidThickBar": true,
    "forbidEllipses": true
  },
  "primitives": {
    "header": {
      "kickerTracking": 0.12,
      "kickerTransform": "uppercase",
      "titleWeight": 700,
      "motif": "refined"
    },
    "callout": {
      "fillToken": "card_bg",
      "shadow": true,
      "textPt": 20,
      "labelPt": 10,
      "paddingX": 32,
      "paddingY": 20,
      "radius": 4
    },
    "listItem": {
      "icon": "square",
      "iconSize": 6,
      "iconGap": 14,
      "itemGap": 12,
      "textPt": 16,
      "lineHeight": 1.35
    }
  },
