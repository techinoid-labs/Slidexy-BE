      "verticalBorders": false,
      "horizontalBorders": true,
      "alternatingRows": true,
      "altRowToken": "surface_color",
      "headerTintToken": "surface_color",
      "headerBold": true,
      "cellPadding": 6,
      "fontMinPt": 14
    },
    "chart": {
      "baseline": true,
      "noDiagonalSegments": true,
      "barCornerRadius": 2,
      "flushBaseline": true
