
# ── AI model tiers ──────────────────────────────────────────────────────────
# QUALITY runs anything the user reads (slide copy, deck generation, AI text
# rewriting). UTILITY runs the cheap mechanical calls. Deck content was
# previously generated on the utility model, which is the likely cause of
# output losing to competitors despite a strong prompt.
OPENROUTER_QUALITY_MODEL=google/gemini-2.5-flash
OPENROUTER_UTILITY_MODEL=google/gemini-2.5-flash-lite
