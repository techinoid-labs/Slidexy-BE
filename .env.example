
# ── AI model tiers ──────────────────────────────────────────────────────────
# QUALITY runs anything the user reads (slide copy, deck generation, AI text
# rewriting). UTILITY runs the cheap mechanical calls. Deck content was
# previously generated on the utility model, which is the likely cause of
# output losing to competitors despite a strong prompt.

# Text model: the self-hosted Groq multi-key proxy.
# The server chooses the model via its own PUT /model, so TEXT_MODEL_NAME
# is only a label for our logs. TEXT_MODEL_URL has no default in code:
# a missing value fails at boot rather than silently using an old host.
TEXT_MODEL_URL=http://64.23.174.222:8010
TEXT_MODEL_NAME=qwen/qwen3.8-27b
TEXT_MODEL_MAX_TOKENS=8192
TEXT_MODEL_TIMEOUT_MS=120000

# Image generation: Cloudflare Workers AI (FLUX.1 schnell).
# Free tier is 10,000 Neurons a day, about 170 images, resetting at
# 00:00 UTC. The model is Apache 2.0, so the output is fine to ship.
# Account id: right-hand column of any page in the Cloudflare dashboard.
# Token: My Profile > API Tokens > Create Token > Workers AI template.
# Leave these blank and the image chain skips Cloudflare and says so.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_IMAGE_TIMEOUT_MS=60000
